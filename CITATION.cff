cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "lair"
version: 2026.12.5
date-released: "2026-09-22"
# Concept DOI (always resolves to the latest release) — same convention as
# pandas/astropy/xarray. `doi` is the shorthand GitHub's "Cite this
# repository" popup actually renders in APA/BibTeX (it ignores
# `identifiers`, per citation-file-format/ruby-cff's formatters);
# `identifiers` is kept too for tools that prefer that form. Deliberately
# not tracking the per-version DOI here — none of the above do either.
doi: "10.5281/zenodo.22900040"
abstract: "lair (Land-Air Interactions Research) is a Python toolkit of atmospheric-science utilities: meteorology, geospatial helpers, HRRR access, emissions inventories, NOAA GML data, upper-air soundings, PCAP/valley heat deficit calculations, CCG-filter backgrounds, and plotting helpers."
identifiers:
  - type: doi
    value: "10.5281/zenodo.22900040"
    description: "The concept DOI for all versions of lair."
authors:
  - family-names: Mineau
    given-names: James K.
    email: jameskmineau@gmail.com
    affiliation: "University of Utah"
    orcid: "https://orcid.org/0000-0002-2289-2252"
license: MIT
repository-code: "https://github.com/jmineau/lair"
url: "https://jmineau.github.io/lair/"
keywords:
  - atmospheric-science
  - land-air-interactions
  - meteorology
  - emissions-inventories
  - greenhouse-gases
  - python
